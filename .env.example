# ─────────────────────────────────────────────────────────────
# Nyumba360 environment template — copy to .env.local and fill in.
# Phase 1 builds offline; these are needed once you link a real
# Supabase project (see README "Connecting to Supabase").
# ─────────────────────────────────────────────────────────────

# Supabase — from your project's API settings (or `supabase start` output for local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Used by invite/admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Africa's Talking — wired in Phase 3 (SMS OTP + notifications). Placeholders for now.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=NYUMBA360
